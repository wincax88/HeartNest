# H5 开发环境通过 Vite 代理访问 /api，无需设置。
# 小程序与 App 需填写已配置 HTTPS 的 API 地址。
VITE_API_BASE_URL=https://heartnest-ns-i61rahoe.gzg.sealos.run/api
HEARTNEST_WECHAT_APP_ID=wxf398149aa702daae
HEARTNEST_APP_ID=

# 以下变量只在服务端设置，绝不要放入 VITE_ 变量。
WECHAT_REMINDER_TEMPLATE_ID=
# 必须与微信后台模板字段一致；{{time}} 会替换为实际提醒的北京时间。
# 示例仅演示格式，不可代替真实模板字段配置。
WECHAT_REMINDER_TEMPLATE_DATA=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HEARTNEST_DATA_FILE=./data/heartnest.json
PORT=8787
